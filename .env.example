# sibic sistema de informacion de balance civico - variables de entorno
# copia este archivo como .env en la raiz del proyecto para desarrollo local:
#   cp .env.example .env
#
# nota importante de seguridad:
# en expo cualquier variable que comience con expo_public_ se compila en el
# codigo de la aplicacion y es visible publicamente en el cliente movil y web.
# nunca agregues claves con permisos administrativos como supabase_service_role_key
# en este archivo.

# 1. supabase backend: autenticacion oauth, respaldos de progreso, comunidad
# url de tu instancia de supabase ejemplo https://xxxx.supabase.co o http://127.0.0.1:54321 en local
EXPO_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# clave publica anon de supabase segura para el cliente protegida por row level security rls
EXPO_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anon-publica-aqui

# 2. contenido editorial packs json y manifest
# url base de github pages o cdn donde se publican manifest.json y los packs de contenido
# por defecto en desarrollo se usan las semillas embebidas offline.
EXPO_PUBLIC_CONTENT_CDN_URL=https://sibic-gt.github.io/content

# 3. entorno de ejecucion
# opciones: development, staging o production
EXPO_PUBLIC_APP_ENV=development
