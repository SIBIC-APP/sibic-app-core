# =============================================================================
# SIBIC (Sistema de Información de Balance Cívico) - Variables de Entorno
# =============================================================================
# Copia este archivo como '.env' en la raíz del proyecto para desarrollo local:
#   cp .env.example .env
#
# NOTA IMPORTANTE DE SEGURIDAD:
# En Expo, cualquier variable que comience con 'EXPO_PUBLIC_' se compila en el
# código de la aplicación y es visible públicamente en el cliente (móvil y web).
# NUNCA agregues claves con permisos administrativos (como 'SUPABASE_SERVICE_ROLE_KEY')
# en este archivo.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Supabase (Backend: Autenticación OAuth, Respaldos de Progreso, Comunidad)
# -----------------------------------------------------------------------------
# URL de tu instancia de Supabase (ej. https://xxxx.supabase.co o http://127.0.0.1:54321 en local)
EXPO_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública 'anon' de Supabase (segura para el cliente, protegida por Row Level Security RLS)
EXPO_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anon-publica-aqui

# -----------------------------------------------------------------------------
# 2. Contenido Editorial (Packs JSON y Manifest)
# -----------------------------------------------------------------------------
# URL base de GitHub Pages o CDN donde se publican 'manifest.json' y los packs de contenido
# Por defecto en desarrollo se usan las semillas embebidas offline.
EXPO_PUBLIC_CONTENT_CDN_URL=https://sibic-gt.github.io/content

# -----------------------------------------------------------------------------
# 3. Entorno de Ejecución
# -----------------------------------------------------------------------------
# Opciones: 'development' | 'staging' | 'production'
EXPO_PUBLIC_APP_ENV=development
